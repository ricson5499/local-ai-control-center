# Local AI Control Center Configuration
# Copy this file to .env and update values as needed
# NEVER commit .env to version control

# Node environment (development or production)
NODE_ENV=production

# Backend server configuration
HOST=127.0.0.1
PORT=8787

# Frontend port (for CORS configuration)
FRONTEND_PORT=4001

# API Bearer Token (generate a strong random token)
# Example: openssl rand -hex 32
API_TOKEN=your-secure-token-here

# Docker Desktop executable path (optional)
# Only set this if the default paths don't work
# DOCKER_DESKTOP_EXE=C:\Program Files\Docker\Docker\Docker Desktop.exe
